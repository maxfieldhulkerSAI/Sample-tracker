# Optional. Leave both unset for direct mode (the browser calls Stability and Gemini
# itself with keys the user pastes into Settings). Set both to route generation
# through the Supabase edge functions in supabase/functions instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server mode only: set these as Supabase function secrets, not here.
#   supabase secrets set STABILITY_API_KEY=sk-your-key-here GEMINI_API_KEY=AIza-your-key-here
